generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum RegistrationCodeStatus {
  UNUSED
  USED
  EXPIRED
  REVOKED
}

model User {
  id                 String   @id @default(cuid())
  clerkId            String?  @unique
  email              String?  @unique
  phone              String?  @unique
  phoneVerified      Boolean  @default(false)
  password           String?
  employeeId         String?  @unique
  role               Role     @default(PATIENT)
  firstName          String?
  lastName           String?
  imageUrl           String?
  city               String?
  profileComplete    Boolean  @default(false)
  registrationCodeId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  doctor       Doctor?
  patient      Patient?
  createdCodes RegistrationCode[] @relation("CreatedBy")
  usedCode     RegistrationCode?  @relation("UsedBy")
  otps         OtpCode[]
  bedUpdates         Bed[]                   @relation("BedUpdatedBy")
  bedLogs            BedStatusLog[]          @relation("BedLogChangedBy")
  assignedComplaints Complaint[]             @relation("ComplaintAssignedTo")
  resolvedComplaints Complaint[]             @relation("ComplaintResolvedBy")
  escalationLogs     ComplaintEscalationLog[] @relation("EscalationTriggeredBy")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
}

model Department {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  doctors    Doctor[]
  wards      Ward[]
  complaints Complaint[]
}

model Doctor {
  id             String   @id @default(cuid())
  userId         String   @unique
  departmentId   String
  specialization String?
  qualification  String?
  experience     Int?
  phone          String?
  available      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department       @relation(fields: [departmentId], references: [id])
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  complaints     Complaint[]
}

model Patient {
  id               String   @id @default(cuid())
  userId           String   @unique
  firstName        String
  lastName         String
  gender           Gender
  dateOfBirth      DateTime
  bloodGroup       String?
  phone            String
  emergencyContact String?
  address          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  bills          Bill[]
  beds           Bed[]
  complaints     Complaint[]
}

model Appointment {
  id              String            @id @default(cuid())
  doctorId        String
  patientId       String
  appointmentDate DateTime
  appointmentTime String
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  doctor        Doctor          @relation(fields: [doctorId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord?
  bill          Bill?
}

model MedicalRecord {
  id            String    @id @default(cuid())
  patientId     String
  doctorId      String
  appointmentId String    @unique
  diagnosis     String?
  symptoms      String?
  treatment     String?
  allergies     String?
  doctorNotes   String?
  followUpDate  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
}

model Prescription {
  id              String   @id @default(cuid())
  medicalRecordId String
  doctorId        String
  instructions    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  medicalRecord MedicalRecord     @relation(fields: [medicalRecordId], references: [id])
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  items         PrescriptionItem[]
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Bill {
  id                String        @id @default(cuid())
  patientId         String
  appointmentId     String        @unique
  consultationFee   Float
  additionalCharges Float         @default(0)
  discount          Float         @default(0)
  totalAmount       Float
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  patient     Patient     @relation(fields: [patientId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model RegistrationCode {
  id           String                  @id @default(cuid())
  code         String                  @unique
  role         Role
  departmentId String?
  status       RegistrationCodeStatus  @default(UNUSED)
  expiresAt    DateTime
  createdById  String
  usedById     String?                 @unique
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  createdBy User   @relation("CreatedBy", fields: [createdById], references: [id])
  usedBy    User?  @relation("UsedBy", fields: [usedById], references: [id])
}

enum BedStatus {
  VACANT
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

enum BedType {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
  NICU
  EMERGENCY
  MATERNITY
}

enum GenderWard {
  MALE
  FEMALE
  MIXED
}

model Ward {
  id           String     @id @default(cuid())
  name         String     @unique
  floor        Int
  departmentId String
  genderWard   GenderWard @default(MIXED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  beds       Bed[]
}

model Bed {
  id              String    @id @default(cuid())
  bedNumber       String
  wardId          String
  bedType         BedType   @default(GENERAL)
  status          BedStatus @default(VACANT)
  patientId       String?
  notes           String?
  statusUpdatedAt DateTime  @default(now())
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ward      Ward           @relation(fields: [wardId], references: [id], onDelete: Cascade)
  patient   Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("BedUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  statusLog BedStatusLog[]

  @@unique([wardId, bedNumber])
}

model BedStatusLog {
  id             String    @id @default(cuid())
  bedId          String
  previousStatus BedStatus
  newStatus      BedStatus
  changedById    String?
  notes          String?
  createdAt      DateTime  @default(now())

  bed       Bed   @relation(fields: [bedId], references: [id], onDelete: Cascade)
  changedBy User? @relation("BedLogChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
}

enum ComplaintType {
  COMPLAINT
  FEEDBACK
  COMPLIMENT
  SUGGESTION
}

enum ComplaintCategory {
  STAFF_BEHAVIOR
  WAIT_TIME
  CLEANLINESS
  BILLING_ISSUE
  TREATMENT_QUALITY
  FACILITY_AMENITIES
  MEDICATION_ERROR
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  SUBMITTED
  ASSIGNED
  UNDER_INVESTIGATION
  RESOLVED
  REJECTED
  CLOSED
}

enum EscalationLevel {
  LEVEL_1_DEPT_HEAD
  LEVEL_2_ADMIN
  LEVEL_3_DIRECTOR
}

model Complaint {
  id                String            @id @default(cuid())
  ticketNumber      String            @unique
  type              ComplaintType     @default(COMPLAINT)
  category          ComplaintCategory
  severity          ComplaintSeverity @default(MEDIUM)
  status            ComplaintStatus   @default(SUBMITTED)
  escalationLevel   EscalationLevel   @default(LEVEL_1_DEPT_HEAD)

  title             String
  description       String
  location          String?

  isAnonymous       Boolean           @default(false)
  patientName       String?
  patientPhone      String?
  patientEmail      String?
  patientId         String?

  departmentId      String
  doctorId          String?

  assignedToId      String?
  resolvedById      String?

  resolutionSummary String?
  actionTaken       String?
  resolvedAt        DateTime?

  slaDeadline       DateTime
  lastEscalatedAt   DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  department        Department        @relation(fields: [departmentId], references: [id])
  doctor            Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient           Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assignedTo        User?             @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy        User?             @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  escalationLogs    ComplaintEscalationLog[]

  @@index([departmentId])
  @@index([status])
  @@index([escalationLevel])
  @@index([slaDeadline])
}

model ComplaintEscalationLog {
  id             String          @id @default(cuid())
  complaintId    String
  fromLevel      EscalationLevel
  toLevel        EscalationLevel
  triggerReason  String
  actionNote     String?
  triggeredById  String?
  createdAt      DateTime        @default(now())

  complaint      Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  triggeredBy    User?           @relation("EscalationTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([complaintId])
}
